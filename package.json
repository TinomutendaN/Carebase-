{
  "name": "carebase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:schema": "tsx --env-file=.env.local scripts/apply-schema.ts",
    "synthea:generate": "java -jar .synthea/synthea-with-dependencies.jar -p 200 -s 4242 -cs 4242 -r 20261127 -a 30-85 --exporter.baseDirectory=.synthea/output --exporter.years_of_history=5 --exporter.fhir.export=true --exporter.hospital.fhir.export=false --exporter.practitioner.fhir.export=false --exporter.fhir.bulk_data=false --generate.only_alive_patients=true",
    "db:import": "tsx --env-file=.env.local scripts/import-synthea.ts",
    "db:wearables": "tsx --env-file=.env.local scripts/generate-wearables.ts",
    "db:check": "tsx --env-file=.env.local scripts/check-data.ts",
    "samples": "tsx --env-file=.env.local scripts/make-samples.ts",
    "db:follow-ups": "tsx --env-file=.env.local scripts/follow-ups.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "demo:lab": "tsx --env-file=.env.local scripts/demo-lab.ts",
    "evidence:build": "tsx --env-file=.env.local scripts/build-evidence.ts",
    "test:assistant": "tsx --env-file=.env.local scripts/run-tests.ts",
    "check:export": "tsx --env-file=.env.local scripts/check-export.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.110",
    "@ai-sdk/openai": "^4.0.125",
    "@ai-sdk/react": "^4.0.188",
    "@neondatabase/serverless": "^1.2.2",
    "ai": "^7.0.183",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
