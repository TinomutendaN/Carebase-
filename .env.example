# Copy to .env.local (never commit .env.local).
# On Vercel, DATABASE_URL is set by the Neon integration; add the rest in Project Settings → Environment Variables.

# Neon Postgres connection string (pooled)
DATABASE_URL=

# "openai" (default) or "anthropic"
AI_PROVIDER=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
# Embeddings for the evidence library (Step 8)
OPENAI_EMBEDDING_MODEL=

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Intake: documents the AI may read per day (keeps the public demo's bill small). Default 50.
INTAKE_DAILY_LIMIT=
# The clinic's time zone, for "today" (insurance expiry, approved today, tasks due). Default America/New_York.
CLINIC_TIMEZONE=
# Assistant: questions answered per day, clinic-wide (keeps the public demo's bill small). Default 200.
ASSISTANT_DAILY_LIMIT=
# Assistant: longest answer per model step, in tokens. Default 800.
ASSISTANT_MAX_OUTPUT_TOKENS=
# Assistant: questions per day for the test runner's accounts, counted apart from the public cap. Default 150.
ASSISTANT_TEST_DAILY_LIMIT=
# Lets scripts/run-tests.ts sign in as the test accounts. Set the same long random value here and on Vercel.
TEST_RUNNER_SECRET=
